<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Dependency-free checks for OverlayUtils.Core (no xUnit, so it builds and runs
    offline, on any OS). Run it with: dotnet run, project tests/OverlayUtils.SelfTest.
    Exit code 0 = all passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Core is marked Windows-only; these checks avoid the Windows-only calls. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OverlayUtils.Core\OverlayUtils.Core.csproj" />
  </ItemGroup>
</Project>
