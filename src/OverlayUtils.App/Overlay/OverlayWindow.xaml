<!--
  The full-screen overlay (Python _Overlay.render, redesigned): the frosted backdrop, then the frame in three
  columns sized by OverlayViewModel.Frame: rail (page icons, gear), column (eyebrow, title, rows, footer) and stage
  (status corner, context card). The controller sizes the window to the monitor; SizeFactor scales the content of
  each zone. Row sizes are Python's, in DIPs at 96 dpi, slightly enlarged. Nothing here is focusable: the window
  takes every key in PreviewKeyDown and turns it into an OverlayCommand.
-->
<Window x:Class="OverlayUtils.App.Overlay.OverlayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OverlayUtils.App.Overlay"
        xmlns:core="clr-namespace:OverlayUtils.Core.Overlay;assembly=OverlayUtils.Core"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Width="1280" Height="720" Background="{DynamicResource FrameBg}"
        FontFamily="{DynamicResource TextFont}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None" KeyboardNavigation.ControlTabNavigation="None"
        PreviewKeyDown="OnPreviewKeyDown" PreviewMouseWheel="OnPreviewMouseWheel" PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp" LostMouseCapture="OnLostMouseCapture"
        IsVisibleChanged="OnIsVisibleChanged"
        MouseRightButtonDown="OnMouseRightButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:UpperCaseConverter x:Key="Upper" />
            <local:ScaleConverter x:Key="Scale" />
            <local:StarConverter x:Key="Star" />

            <!--
              Rail button (page icon or the Settings gear): the Content is the glyph, Tag (bool) lights it with the
              accent tint, the bar and full opacity. The click handler is set where it is used.
            -->
            <Style x:Key="RailButton" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="{StaticResource RailButtonSize}" />
                <Setter Property="Height" Value="{StaticResource RailButtonSize}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid Background="Transparent">
                                <Border x:Name="HoverBg" CornerRadius="14" Background="{StaticResource Hover}"
                                        Visibility="Collapsed" />
                                <Border x:Name="Lit" CornerRadius="14" Background="{DynamicResource Accent}"
                                        Opacity="{StaticResource TintOpacity}" Visibility="Collapsed" />
                                <Rectangle x:Name="Bar" Width="3" Height="24" RadiusX="1.5" RadiusY="1.5"
                                           HorizontalAlignment="Left" Fill="{DynamicResource Accent}"
                                           Visibility="Collapsed" />
                                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Opacity="0.5"
                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{StaticResource RailGlyphSize}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverBg" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="Tag">
                                    <Trigger.Value>
                                        <sys:Boolean>True</sys:Boolean>
                                    </Trigger.Value>
                                    <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shown only on the selected row (tint, accent bar). -->
            <Style x:Key="SelectedOnly" TargetType="FrameworkElement">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Tint" TargetType="Border" BasedOn="{StaticResource SelectedOnly}">
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="Opacity" Value="{StaticResource TintOpacity}" />
                <Setter Property="OpacityMask" Value="{StaticResource TintFade}" />
            </Style>
            <Style x:Key="AccentBar" TargetType="Rectangle" BasedOn="{StaticResource SelectedOnly}">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="22" />
                <Setter Property="RadiusX" Value="1.5" />
                <Setter Property="RadiusY" Value="1.5" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Fill" Value="{DynamicResource Accent}" />
            </Style>
            <Style x:Key="RowIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <!-- Small chevrons of choice and action rows: brighter on the selected row. -->
            <Style x:Key="RowChevron" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Faint tint on the row under the mouse pointer (the accent tint marks the selection). -->
            <Style x:Key="HoverTint" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Hover}" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Clickable element inside a row or the header: hand cursor and a light background on hover. -->
            <Style x:Key="HoverButton" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="CornerRadius" Value="6" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource Hover}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
              Frame of the standard rows (Python _render_rows): optional section header, 40 px row with tint and
              accent bar, icon, label, and the kind's control (the Content) on the right. A Child row (an app under
              its channel) has its icon and label indented 24 DIP and a smaller label; tint, bar and mouse stay.
            -->
            <Style x:Key="RowFrame" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <StackPanel>
                                <TextBlock Text="{Binding Section}" Margin="12,14,0,2" Height="20" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource Subtle}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Section}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Height="{StaticResource RowHeight}" Margin="0,0,0,2" Background="Transparent"
                                      Cursor="Hand" MouseLeftButtonDown="OnRowMouseDown">
                                    <Border Style="{StaticResource HoverTint}" CornerRadius="8" />
                                    <Border Style="{StaticResource Tint}" CornerRadius="8" />
                                    <Rectangle Style="{StaticResource AccentBar}" />
                                    <Grid x:Name="RowContent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RowGlyph" Style="{StaticResource RowIcon}" Text="{Binding Icon}"
                                                   FontSize="{StaticResource RowGlyphSize}" Margin="2,0,0,0" />
                                        <TextBlock x:Name="RowLabel" Grid.Column="1" Text="{Binding Label}"
                                                   FontSize="{StaticResource RowLabelSize}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,10,0" />
                                        <ContentPresenter Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Child}" Value="True">
                                    <Setter TargetName="RowContent" Property="Margin" Value="24,0,0,0" />
                                    <Setter TargetName="RowGlyph" Property="FontSize" Value="15" />
                                    <Setter TargetName="RowLabel" Property="FontSize" Value="14" />
                                    <Setter TargetName="RowLabel" Property="Foreground" Value="{StaticResource Muted}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Child}" Value="True" />
                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="RowLabel" Property="Foreground" Value="{StaticResource Text}" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ActionRow">
                <ContentControl Style="{StaticResource RowFrame}">
                    <Grid>
                        <Border Margin="0,0,4,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Keycap}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource KeycapText}" Text="{Binding Hint}" />
                        </Border>
                        <TextBlock Text="{x:Static core:Glyphs.ChevronRight}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RowChevron}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasChevron}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ContentControl>
            </DataTemplate>

            <!-- One option pill of a segmented row or tile; the click walks up to the row. -->
            <DataTemplate x:Key="SegmentPill">
                <Border x:Name="Pill" CornerRadius="11" Padding="9,0" BorderThickness="1"
                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                        MouseLeftButtonDown="OnOptionMouseDown">
                    <TextBlock x:Name="PillText" Text="{Binding Label}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}" />
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Pill" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource Hover}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Text}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource SegmentActive}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCursor}" Value="True">
                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPending}" Value="True">
                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource Danger}" />
                        <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Danger}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The capsule of pills (segmented rows and tiles). -->
            <Style x:Key="SegmentCapsule" TargetType="Border">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="3" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="{StaticResource SegmentBg}" />
            </Style>

            <!-- Python _render_segmented: pills in a dark capsule; cursor outlined, pending in danger red. -->
            <DataTemplate x:Key="SegmentedRow">
                <ContentControl Style="{StaticResource RowFrame}">
                    <Border Style="{StaticResource SegmentCapsule}">
                        <ItemsControl ItemsSource="{Binding Options}" Focusable="False"
                                      ItemTemplate="{StaticResource SegmentPill}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ContentControl>
            </DataTemplate>

            <!-- Python _render_choice: ‹ value › -->
            <DataTemplate x:Key="ChoiceRow">
                <ContentControl Style="{StaticResource RowFrame}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                        <Border Style="{StaticResource HoverButton}" Tag="-1" Width="22" Height="26"
                                MouseLeftButtonDown="OnStepMouseDown">
                            <TextBlock Style="{StaticResource RowChevron}" Text="{x:Static core:Glyphs.ChevronLeft}" />
                        </Border>
                        <TextBlock Text="{Binding Value}" FontSize="13" Margin="6,0" MaxWidth="200"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border Style="{StaticResource HoverButton}" Tag="1" Width="22" Height="26"
                                MouseLeftButtonDown="OnStepMouseDown">
                            <TextBlock Style="{StaticResource RowChevron}" Text="{x:Static core:Glyphs.ChevronRight}" />
                        </Border>
                    </StackPanel>
                </ContentControl>
            </DataTemplate>

            <!-- Python _switch: Windows 11 toggle, filled with the accent when on. -->
            <DataTemplate x:Key="ToggleRow">
                <ContentControl Style="{StaticResource RowFrame}">
                    <Grid Width="40" Height="20" Margin="0,0,4,0">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource Muted}" Background="Transparent" />
                        <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                 Fill="{StaticResource Muted}" />
                    </Grid>
                </ContentControl>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                        <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Bg}" />
                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Info page panel header (Python _render_info): a card with a chevron that turns down when open. -->
            <DataTemplate x:Key="ExpanderRow">
                <Grid Height="40" Margin="0,6,0,0" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnRowMouseDown">
                    <Border CornerRadius="8" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardLine}"
                            BorderThickness="1" />
                    <Border Style="{StaticResource HoverTint}" CornerRadius="8" />
                    <Border Style="{StaticResource Tint}" CornerRadius="8" />
                    <Rectangle Style="{StaticResource AccentBar}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowIcon}" Text="{Binding Icon}" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Chevron" Grid.Column="2" Style="{StaticResource Icon}" FontSize="10"
                                   Margin="0,0,14,0" Foreground="{StaticResource Muted}"
                                   Text="{x:Static core:Glyphs.ChevronRight}" />
                    </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <!-- Python ICON_CHEVRON_DOWN -->
                        <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Compact label/value row inside an open Info panel, with the action word on the right. -->
            <DataTemplate x:Key="InfoRow">
                <Grid Height="25" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnRowMouseDown">
                    <Border Style="{StaticResource HoverTint}" CornerRadius="6" Margin="6,0" />
                    <Border Style="{StaticResource Tint}" CornerRadius="6" Margin="6,0" />
                    <Rectangle Style="{StaticResource AccentBar}" Margin="6,0,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12" Margin="16,0,6,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="Hint" Grid.Column="2" Text="{Binding Hint}" FontSize="12"
                                   Margin="10,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" />
                    </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Hint" Property="Foreground" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Python _render_slider: thin bar filled with the accent (grey when muted), knob, then the percent. -->
            <DataTemplate x:Key="SliderRow">
                <ContentControl Style="{StaticResource RowFrame}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                        <Grid Width="134" Height="24" VerticalAlignment="Center" Background="Transparent"
                              Cursor="Hand" Tag="VolumeBar" MouseLeftButtonDown="OnBarMouseDown">
                            <Grid Margin="7,0" Height="14">
                                <Border Height="4" CornerRadius="2" Background="{StaticResource Line}" />
                                <Border x:Name="Fill" Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                        Width="{Binding SliderFill}" Background="{DynamicResource Accent}" />
                                <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left"
                                         Margin="{Binding KnobMargin}" Fill="{StaticResource Muted}" />
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="Percent" Text="{Binding Value}" Width="48" TextAlignment="Right" FontSize="13"
                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </ContentControl>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Subtle}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Text}" />
                        <Setter TargetName="Percent" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--
              Python _render_media: a card with the music tile, title and artist · app, and previous / play-pause /
              next on the right; the selected card gets an accent outline.
            -->
            <DataTemplate x:Key="MediaRow">
                <StackPanel>
                    <TextBlock Text="{Binding Section}" Margin="12,14,0,2" Height="20" FontSize="11"
                               FontWeight="SemiBold" Foreground="{StaticResource Subtle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Height="64" Margin="2,2,2,4" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnRowMouseDown">
                        <Border x:Name="Outline" CornerRadius="12" Margin="-2" BorderThickness="2"
                                BorderBrush="Transparent" />
                        <Border CornerRadius="10" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardLine}"
                                BorderThickness="1" />
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" Background="{StaticResource SegmentActive}">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Music}" FontSize="18"
                                           Foreground="{StaticResource Muted}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Subtitle" Text="{Binding Value}" Margin="0,2,0,0" FontSize="12"
                                           Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource HoverButton}" Tag="-1" Width="30" Height="30"
                                        CornerRadius="15" MouseLeftButtonDown="OnMediaMouseDown">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Previous}" FontSize="14" />
                                </Border>
                                <Grid Width="32" Height="32" Margin="4,0" Cursor="Hand" Tag="0"
                                      MouseLeftButtonDown="OnMediaMouseDown">
                                    <Ellipse x:Name="PlayDisc" Fill="{DynamicResource Accent}" />
                                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" FontSize="14"
                                               Text="{x:Static core:Glyphs.Play}" Foreground="{StaticResource Bg}" />
                                </Grid>
                                <Border Style="{StaticResource HoverButton}" Tag="1" Width="30" Height="30"
                                        CornerRadius="15" MouseLeftButtonDown="OnMediaMouseDown">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Next}" FontSize="14" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="PlayGlyph" Property="Text" Value="{x:Static core:Glyphs.Pause}" />
                    </DataTrigger>
                    <Trigger SourceName="PlayDisc" Property="IsMouseOver" Value="True">
                        <Setter TargetName="PlayDisc" Property="Opacity" Value="0.8" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Value}" Value="">
                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Entry of a priority list: status on the right; while picked up, an accent ↑ ↓ pill replaces it. -->
            <DataTemplate x:Key="ReorderRow">
                <ContentControl Style="{StaticResource RowFrame}">
                    <Grid Margin="0,0,4,0">
                        <TextBlock x:Name="Status" Text="{Binding Value}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}" />
                        <Border x:Name="Held" Height="22" Padding="10,0" CornerRadius="11" BorderThickness="1"
                                BorderBrush="{DynamicResource Accent}" Visibility="Collapsed">
                            <TextBlock Text="↑ ↓" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}" />
                        </Border>
                    </Grid>
                </ContentControl>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Status" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsHeld}" Value="True">
                        <Setter TargetName="Status" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Held" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--
              The Games grid row draws nothing in the row list: the page has its own hero, source pills and cover
              shelf (TileList), which read the same row through the view model.
            -->
            <DataTemplate x:Key="GridRow">
                <Border />
            </DataTemplate>

            <!--
              One game on the shelf: cover (or icon, or a placeholder glyph), source badge, title below. The selected
              cover lifts (scaled from its bottom edge, so it grows upwards) with a white outline and an accent glow;
              tiles off the selected row are dimmed. The lift is static for now (motion comes later).
            -->
            <DataTemplate x:Key="GameTile">
                <Grid x:Name="Tile" Margin="{StaticResource CoverMargin}" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="OnTileMouseDown">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Cover" RenderTransformOrigin="0.5,1">
                        <!-- Covers are 2:3: the cover row takes its height from the cell width. -->
                        <Border Height="{Binding ActualWidth, ElementName=Tile, Converter={StaticResource Scale}, ConverterParameter=1.5}" />
                        <Border x:Name="Glow" Margin="-4" CornerRadius="12" BorderThickness="5"
                                BorderBrush="{DynamicResource Accent}" Opacity="{StaticResource CoverGlowOpacity}"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <BlurEffect Radius="{StaticResource CoverGlowRadius}" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="8" Background="{StaticResource CardBg}" />
                        <TextBlock x:Name="Placeholder" Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Game}"
                                   FontSize="30" Foreground="{StaticResource Subtle}" />
                        <Image Source="{Binding Icon}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border CornerRadius="8">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="HoverShade" CornerRadius="8" Background="{StaticResource Hover}" Visibility="Collapsed" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="5,1" CornerRadius="4"
                                Background="{StaticResource FrameBg}" Opacity="0.85">
                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border x:Name="Outline" CornerRadius="10" Margin="-2" BorderThickness="2" BorderBrush="Transparent" />
                    </Grid>
                    <TextBlock x:Name="TileTitle" Grid.Row="1" Text="{Binding Title}" Margin="2,8,2,0" FontSize="12"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasArt}" Value="True">
                        <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                        <Setter TargetName="HoverShade" Property="Visibility" Value="Visible" />
                        <Setter TargetName="TileTitle" Property="Foreground" Value="{StaticResource Text}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                        <Setter TargetName="Tile" Property="Opacity" Value="{StaticResource ShelfDimOpacity}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Cover" Property="RenderTransform" Value="{StaticResource CoverLiftTransform}" />
                        <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Text}" />
                        <Setter TargetName="TileTitle" Property="Foreground" Value="{StaticResource Text}" />
                        <Setter TargetName="TileTitle" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- One source pill of the Games page; the current one is lit with the accent. A click shows that source. -->
            <DataTemplate x:Key="SourcePill">
                <Grid x:Name="Pill" Height="{StaticResource PillHeight}" Margin="0,0,8,0" Background="Transparent"
                      Cursor="Hand" MouseLeftButtonDown="OnPillMouseDown">
                    <Border x:Name="PillBg" CornerRadius="15" Background="{StaticResource CardBg}" />
                    <Border x:Name="Lit" CornerRadius="15" Background="{DynamicResource Accent}"
                            Opacity="{StaticResource PillLitOpacity}" Visibility="Collapsed" />
                    <Border x:Name="Outline" CornerRadius="15" BorderThickness="1" BorderBrush="Transparent" />
                    <TextBlock x:Name="PillText" Text="{Binding Label}" Margin="14,0" FontSize="{StaticResource PillTextSize}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Pill" Property="IsMouseOver" Value="True">
                        <Setter TargetName="PillBg" Property="Background" Value="{StaticResource Hover}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Text}" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource Text}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--
              Home tiles: the same rows (same RowVm, same handlers) drawn as shortcut tiles. The frame is a glass card
              with the row's icon and caption at the top and the kind's control (the Content) below; the selected tile
              gets the accent tint, a 2 DIP accent outline and a soft glow. No section headers.
            -->
            <Style x:Key="TileFrame" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid x:Name="Tile" MinHeight="{StaticResource TileHeight}" Background="Transparent"
                                  Cursor="Hand" MouseLeftButtonDown="OnRowMouseDown">
                                <Border x:Name="Glow" Margin="-3" CornerRadius="17" BorderThickness="4"
                                        BorderBrush="{DynamicResource Accent}" Opacity="{StaticResource TileGlowOpacity}"
                                        Visibility="Collapsed">
                                    <Border.Effect>
                                        <BlurEffect Radius="{StaticResource TileGlowRadius}" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="{StaticResource TileCorner}" Background="{StaticResource CardBg}"
                                        BorderBrush="{StaticResource CardLine}" BorderThickness="1" />
                                <Border x:Name="HoverBg" CornerRadius="{StaticResource TileCorner}"
                                        Background="{StaticResource Hover}" Visibility="Collapsed" />
                                <Border x:Name="Lit" CornerRadius="{StaticResource TileCorner}" Background="{DynamicResource Accent}"
                                        Opacity="{StaticResource TintOpacity}" Visibility="Collapsed" />
                                <Border x:Name="Outline" CornerRadius="{StaticResource TileCorner}" BorderThickness="2"
                                        BorderBrush="Transparent" />
                                <DockPanel Margin="16,12,14,12">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource RowIcon}" Text="{Binding Icon}"
                                                   FontSize="{StaticResource TileGlyphSize}" />
                                        <TextBlock x:Name="Caption" Text="{Binding Caption, Converter={StaticResource Upper}}"
                                                   Margin="9,0,0,0" FontSize="{StaticResource TileCaptionSize}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <ContentPresenter Margin="0,8,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverBg" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Glow" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Caption" Property="Foreground" Value="{StaticResource Text}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Caption}" Value="">
                                    <Setter TargetName="Caption" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Big value or label of a tile; muted until the tile is selected. -->
            <Style x:Key="TileText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TileTextSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <!-- Volume (wide): the output device in the caption, the percent (or Muted) big, a bar across the tile. -->
            <DataTemplate x:Key="SliderTile">
                <ContentControl Style="{StaticResource TileFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Percent" Style="{StaticResource TileText}" Text="{Binding Value}" MinWidth="72"
                                   FontFamily="{StaticResource DisplayFont}" FontSize="{StaticResource TileValueSize}" />
                        <!-- Same contract as the row's bar: Tag VolumeBar (wheel), 7 DIP inset on each side (drag). -->
                        <Grid Grid.Column="1" Height="26" Margin="10,0,0,0" VerticalAlignment="Center"
                              Background="Transparent" Cursor="Hand" Tag="VolumeBar" MouseLeftButtonDown="OnBarMouseDown">
                            <Grid Margin="7,0" Height="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Level, Converter={StaticResource Star}}" />
                                    <ColumnDefinition Width="{Binding Level, Converter={StaticResource Star}, ConverterParameter=rest}" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{StaticResource Line}" />
                                <Border x:Name="Fill" CornerRadius="3" Background="{DynamicResource Accent}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </ContentControl>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Subtle}" />
                        <Setter TargetName="Percent" Property="Foreground" Value="{StaticResource Muted}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Now playing (wide): art, title, artist · app, previous / play-pause / next. -->
            <DataTemplate x:Key="MediaTile">
                <ContentControl Style="{StaticResource TileFrame}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44">
                            <Border CornerRadius="8" Background="{StaticResource SegmentActive}">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Music}" FontSize="19"
                                           Foreground="{StaticResource Muted}" />
                            </Border>
                            <!-- The album art over the glyph, once the session has one. -->
                            <Border x:Name="TileArt" CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TileText}" Text="{Binding Label}" />
                            <TextBlock x:Name="Subtitle" Text="{Binding Value}" Margin="0,2,0,0" FontSize="12.5"
                                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource HoverButton}" Tag="-1" Width="32" Height="32"
                                    CornerRadius="16" MouseLeftButtonDown="OnMediaMouseDown">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Previous}" FontSize="15" />
                            </Border>
                            <Grid Width="36" Height="36" Margin="4,0" Cursor="Hand" Tag="0"
                                  MouseLeftButtonDown="OnMediaMouseDown">
                                <Ellipse x:Name="PlayDisc" Fill="{DynamicResource Accent}" />
                                <TextBlock x:Name="PlayGlyph" Style="{StaticResource Icon}" FontSize="15"
                                           Text="{x:Static core:Glyphs.Play}" Foreground="{StaticResource Bg}" />
                            </Grid>
                            <Border Style="{StaticResource HoverButton}" Tag="1" Width="32" Height="32"
                                    CornerRadius="16" MouseLeftButtonDown="OnMediaMouseDown">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Next}" FontSize="15" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </ContentControl>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOn}" Value="True">
                        <Setter TargetName="PlayGlyph" Property="Text" Value="{x:Static core:Glyphs.Pause}" />
                    </DataTrigger>
                    <Trigger SourceName="PlayDisc" Property="IsMouseOver" Value="True">
                        <Setter TargetName="PlayDisc" Property="Opacity" Value="0.8" />
                    </Trigger>
                    <DataTrigger Binding="{Binding Value}" Value="">
                        <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Art}" Value="{x:Null}">
                        <Setter TargetName="TileArt" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Choice (microphone, or the monitor with many profiles): the value big, ‹ › to switch it. -->
            <DataTemplate x:Key="ChoiceTile">
                <ContentControl Style="{StaticResource TileFrame}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                            <Border Style="{StaticResource HoverButton}" Tag="-1" Width="24" Height="28"
                                    MouseLeftButtonDown="OnStepMouseDown">
                                <TextBlock Style="{StaticResource RowChevron}" Text="{x:Static core:Glyphs.ChevronLeft}" />
                            </Border>
                            <Border Style="{StaticResource HoverButton}" Tag="1" Width="24" Height="28"
                                    MouseLeftButtonDown="OnStepMouseDown">
                                <TextBlock Style="{StaticResource RowChevron}" Text="{x:Static core:Glyphs.ChevronRight}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource TileText}" Text="{Binding Value}" />
                    </DockPanel>
                </ContentControl>
            </DataTemplate>

            <!-- Segmented (Screen Desk / TV, Big Picture Open / Exit): the pills, shrunk only when they do not fit. -->
            <DataTemplate x:Key="SegmentedTile">
                <ContentControl Style="{StaticResource TileFrame}">
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="28">
                        <Border Style="{StaticResource SegmentCapsule}">
                            <ItemsControl ItemsSource="{Binding Options}" Focusable="False"
                                          ItemTemplate="{StaticResource SegmentPill}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Border>
                    </Viewbox>
                </ContentControl>
            </DataTemplate>

            <!-- Action (Close window) and any other kind: the label big, the hint as a keycap on the right. -->
            <DataTemplate x:Key="ActionTile">
                <ContentControl Style="{StaticResource TileFrame}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Margin="6,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Keycap}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hint}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource KeycapText}" Text="{Binding Hint}" />
                        </Border>
                        <TextBlock Style="{StaticResource TileText}" Text="{Binding Label}" />
                    </DockPanel>
                </ContentControl>
            </DataTemplate>

            <!--
              Stage context cards (ContextHost, bottom left of the stage), one per ContextVm.Kind. Title, value line and
              body text collapse when empty.
            -->
            <Style x:Key="ContextTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="FontSize" Value="{StaticResource ContextTitleSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ContextValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource ContextValueSize}" />
                <Setter Property="Margin" Value="0,4,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ContextBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource ContextSize}" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ContextCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
                <Setter Property="MaxWidth" Value="{StaticResource ContextWidth}" />
                <Setter Property="Padding" Value="20,16" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!-- Default: the row's label, its value (if any) and its description. -->
            <DataTemplate x:Key="TextContext">
                <Border Style="{StaticResource ContextCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource ContextTitle}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource ContextValue}" Text="{Binding Value}" />
                        <TextBlock Style="{StaticResource ContextBody}" Text="{Binding Text}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Screen row / tile: one small screen per monitor profile, the active one lit. -->
            <DataTemplate x:Key="MonitorsContext">
                <Border Style="{StaticResource ContextCard}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Monitors}" Focusable="False" Margin="0,4,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Monitor" Margin="{StaticResource MonitorMargin}" Opacity="0.6">
                                        <!-- The screen, its stand and foot. -->
                                        <Grid Width="{StaticResource MonitorWidth}" Height="{StaticResource MonitorHeight}">
                                            <Border x:Name="Lit" CornerRadius="5" Background="{DynamicResource Accent}"
                                                    Opacity="0" />
                                            <Border x:Name="Screen" CornerRadius="5" BorderThickness="2"
                                                    BorderBrush="{StaticResource Subtle}" />
                                        </Grid>
                                        <Rectangle x:Name="Stand" Width="6" Height="7" Fill="{StaticResource Subtle}" />
                                        <Rectangle x:Name="Foot" Width="28" Height="3" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{StaticResource Subtle}" />
                                        <TextBlock Text="{Binding Name}" Margin="0,6,0,0" FontSize="13"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="{StaticResource MonitorWidth}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                            <Setter TargetName="Monitor" Property="Opacity" Value="1" />
                                            <Setter TargetName="Lit" Property="Opacity" Value="{StaticResource TintOpacity}" />
                                            <Setter TargetName="Screen" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="Stand" Property="Fill" Value="{DynamicResource Accent}" />
                                            <Setter TargetName="Foot" Property="Fill" Value="{DynamicResource Accent}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource ContextTitle}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource ContextBody}" Text="{Binding Text}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!--
              Audio page, volume and channel rows: the whole mix as vertical bars (channels, then master), the
              selected one outlined; below, the selected channel with its apps.
            -->
            <DataTemplate x:Key="MixerContext">
                <Border Style="{StaticResource ContextCard}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Bars}" Focusable="False" Margin="0,4,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Slot" Width="{StaticResource MixerSlotWidth}" Margin="0,0,0,6"
                                                Opacity="0.7">
                                        <Border x:Name="Outline" HorizontalAlignment="Center" Padding="3" CornerRadius="11"
                                                BorderThickness="2" BorderBrush="Transparent">
                                            <Grid Width="{StaticResource MixerBarWidth}" Height="{StaticResource MixerBarHeight}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="{Binding Level, Converter={StaticResource Star}, ConverterParameter=rest}" />
                                                    <RowDefinition Height="{Binding Level, Converter={StaticResource Star}}" />
                                                </Grid.RowDefinitions>
                                                <Border Grid.RowSpan="2" CornerRadius="8" Background="{StaticResource MixerTrack}" />
                                                <Border x:Name="Fill" Grid.Row="1" CornerRadius="8" Background="{DynamicResource Accent}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="BarName" Text="{Binding Name}" Margin="0,8,0,0" FontSize="12.5"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="{StaticResource MixerSlotWidth}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Muted}" Value="True">
                                            <Setter TargetName="Fill" Property="Background" Value="{StaticResource Subtle}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Selected}" Value="True">
                                            <Setter TargetName="Slot" Property="Opacity" Value="1" />
                                            <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Text}" />
                                            <Setter TargetName="BarName" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Margin="12,0,0,0"
                                       FontSize="{StaticResource ContextValueSize}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Muted}" />
                            <TextBlock Style="{StaticResource ContextTitle}" Text="{Binding Title}" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource ContextValue}" Text="{Binding Apps}" />
                        <TextBlock Style="{StaticResource ContextBody}" Text="{Binding Text}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Now playing: the album art large (a music glyph until it arrives), title, artist · app. -->
            <DataTemplate x:Key="MediaContext">
                <Border Style="{StaticResource ContextCard}" Padding="16">
                    <StackPanel>
                        <Grid Width="{StaticResource ContextArtSize}" Height="{StaticResource ContextArtSize}"
                              HorizontalAlignment="Left">
                            <Border CornerRadius="10" Background="{StaticResource SegmentActive}">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Music}"
                                           FontSize="{StaticResource ContextArtGlyphSize}" Foreground="{StaticResource Muted}" />
                            </Border>
                            <Border x:Name="Art" CornerRadius="10">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                        </Grid>
                        <TextBlock Style="{StaticResource ContextTitle}" Text="{Binding Title}" Margin="4,14,4,0"
                                   MaxWidth="{StaticResource ContextArtSize}" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource ContextBody}" Text="{Binding Text}" Margin="4,4,4,2"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   MaxWidth="{StaticResource ContextArtSize}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Art}" Value="{x:Null}">
                        <Setter TargetName="Art" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Home volume tile: the output device, the volume big, and its cap (else the description). -->
            <DataTemplate x:Key="VolumeContext">
                <Border Style="{StaticResource ContextCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,10,0"
                                       FontSize="{StaticResource ContextGlyphSize}" Foreground="{StaticResource Muted}" />
                            <TextBlock Style="{StaticResource ContextTitle}" Text="{Binding Title}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Value}" Margin="0,6,0,0" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource ContextBigSize}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource ContextBody}" Text="{Binding Text}" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <local:ContextTemplateSelector x:Key="ContextTemplates"
                                           Text="{StaticResource TextContext}"
                                           Monitors="{StaticResource MonitorsContext}"
                                           Mixer="{StaticResource MixerContext}"
                                           Media="{StaticResource MediaContext}"
                                           Volume="{StaticResource VolumeContext}" />

            <local:RowTemplateSelector x:Key="TileTemplates"
                                       Action="{StaticResource ActionTile}"
                                       Segmented="{StaticResource SegmentedTile}"
                                       Choice="{StaticResource ChoiceTile}"
                                       Toggle="{StaticResource ActionTile}"
                                       Expander="{StaticResource ActionTile}"
                                       Info="{StaticResource ActionTile}"
                                       Slider="{StaticResource SliderTile}"
                                       Media="{StaticResource MediaTile}"
                                       Reorder="{StaticResource ActionTile}"
                                       Grid="{StaticResource ActionTile}" />

            <local:RowTemplateSelector x:Key="RowTemplates"
                                       Action="{StaticResource ActionRow}"
                                       Segmented="{StaticResource SegmentedRow}"
                                       Choice="{StaticResource ChoiceRow}"
                                       Toggle="{StaticResource ToggleRow}"
                                       Expander="{StaticResource ExpanderRow}"
                                       Info="{StaticResource InfoRow}"
                                       Slider="{StaticResource SliderRow}"
                                       Media="{StaticResource MediaRow}"
                                       Reorder="{StaticResource ReorderRow}"
                                       Grid="{StaticResource GridRow}" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- Bottom layer: the frosted screenshot. A click on it (outside rail, column and stage cards) closes. -->
        <local:FrostedBackdrop x:Name="Backdrop" MouseLeftButtonDown="OnBackdropMouseDown" />

        <!-- The frame: it slides and fades in on open (the backdrop does not move). No background of its own, so
             the stage's empty space is the backdrop's. -->
        <Grid x:Name="FrameRoot">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding RailWidth}" />
                <ColumnDefinition Width="{Binding ColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
              Rail: one icon per visible tab (LT / RT order), centred; the Settings gear at the bottom. Icons and gear
              have rows of their own (the outer rows keep the gear's height), so they never overlap on a short screen.
            -->
            <Border x:Name="Rail" Background="Transparent" BorderBrush="{StaticResource RailLine}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding SizeFactor}" ScaleY="{Binding SizeFactor}" />
                    </Grid.LayoutTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="{StaticResource RailEndHeight}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="{StaticResource RailEndHeight}" />
                    </Grid.RowDefinitions>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RailItems}" Focusable="False"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource RailButton}" Margin="0,7" Content="{Binding Glyph}"
                                                Tag="{Binding IsCurrent}" ToolTip="{Binding Title}"
                                                MouseLeftButtonDown="OnRailMouseDown" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl x:Name="Gear" Grid.Row="2" Style="{StaticResource RailButton}" Margin="0,0,0,28"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                    Content="{x:Static core:Glyphs.Settings}" Tag="{Binding SettingsCurrent}"
                                    ToolTip="{Binding SettingsTitle}" MouseLeftButtonDown="OnGearMouseDown" />
                </Grid>
            </Border>

            <!--
              Column: eyebrow, page title, rows, footer at the bottom. Transparent, so a click in it never reaches the
              backdrop. On Games it takes the stage too (hero, source pills, the cover shelf) and has no background:
              only those parts take the mouse, a click on the empty space around them closes as on the other pages.
            -->
            <Border x:Name="Column" Grid.Column="1" Padding="{Binding ColumnPadding}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWide}" Value="True">
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Background" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <DockPanel.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding SizeFactor}" ScaleY="{Binding SizeFactor}" />
                    </DockPanel.LayoutTransform>

                    <StackPanel DockPanel.Dock="Top" Margin="12,0,0,10" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Eyebrow, Converter={StaticResource Upper}}" FontSize="{StaticResource EyebrowSize}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" />
                        <!--
                          On Settings, Info and sub-pages a back chevron precedes the title; a click on it is B. On the
                          Games shelf the hero's game title takes its place.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowTiles}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Style="{StaticResource HoverButton}" Width="32" Height="32" Margin="-8,0,4,0"
                                    VerticalAlignment="Center" MouseLeftButtonDown="OnBackMouseDown">
                                <Border.Visibility>
                                    <Binding Path="IsOnPage">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </Border.Visibility>
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.ChevronLeft}"
                                           FontSize="16" Foreground="{StaticResource Muted}" />
                            </Border>
                            <TextBlock Text="{Binding PageTitle}" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="{StaticResource PageTitleSize}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                      Games hero: the selected game's title (large), its source badge and the Play button (a click is
                      A, which launches the selected game). Left aligned and capped in width, so it never runs under
                      the status corner and the space beside it stays the backdrop's.
                    -->
                    <StackPanel x:Name="Hero" DockPanel.Dock="Top" Margin="12,0,0,0" HorizontalAlignment="Left"
                                MaxWidth="{StaticResource HeroMaxWidth}" Background="Transparent">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Hero}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding Hero.Title}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource HeroTitleSize}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Height="{StaticResource PillHeight}" Padding="12,0" CornerRadius="15"
                                    Background="{StaticResource BadgeBg}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Hero.Badge}" FontSize="{StaticResource PillTextSize}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="PlayButton" Height="{StaticResource PlayHeight}" Padding="16,0,10,0"
                                    Margin="12,0,0,0" CornerRadius="19" Background="{StaticResource PlayBg}"
                                    Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="OnPlayMouseDown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="{x:Static core:Glyphs.Play}" FontSize="14"
                                               Foreground="{StaticResource PlayText}" />
                                    <TextBlock Text="{Binding PlayLabel}" Margin="9,0,10,0" FontSize="{StaticResource PlayTextSize}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{StaticResource PlayText}" />
                                    <Border Height="22" Padding="7,0" CornerRadius="5" VerticalAlignment="Center"
                                            Background="{StaticResource PlayKeyBg}">
                                        <TextBlock Text="{Binding PlayKeys}" FontSize="11" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{StaticResource PlayText}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Games source filter: All and each source with games, the current one lit; the number of games. -->
                    <StackPanel x:Name="SourcePills" DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,26,0,6"
                                HorizontalAlignment="Left">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowTiles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Pills}" Focusable="False" ItemTemplate="{StaticResource SourcePill}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding GameCount}" Margin="8,0,0,0" FontSize="{StaticResource PillTextSize}"
                                   VerticalAlignment="Center" Foreground="{StaticResource Subtle}" />
                    </StackPanel>

                    <!--
                      Footer (Python _render_footer), pinned to the bottom on every page. The Viewbox only shrinks it
                      when a language's labels are wider than the column.
                    -->
                    <Viewbox DockPanel.Dock="Bottom" Height="22" Margin="12,12,0,0" HorizontalAlignment="Left"
                             Stretch="Uniform" StretchDirection="DownOnly">
                        <ItemsControl ItemsSource="{Binding Footer}" Focusable="False" Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel x:Name="Hint" Orientation="Horizontal" Height="22" Margin="0,0,16,0"
                                                Background="Transparent" MouseLeftButtonDown="OnFooterMouseDown">
                                        <Border Style="{StaticResource Keycap}" Padding="5,0">
                                            <TextBlock Style="{StaticResource KeycapText}" Text="{Binding Keys}" />
                                        </Border>
                                        <TextBlock x:Name="HintLabel" Text="{Binding Label}" Margin="6,0,0,0" FontSize="12.5"
                                                   VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsClickable}" Value="True">
                                            <Setter TargetName="Hint" Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsClickable}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, ElementName=Hint}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="HintLabel" Property="Foreground" Value="{StaticResource Text}" />
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>

                    <ScrollViewer x:Name="Scroller" Focusable="False" VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,0,8">
                            <ItemsControl x:Name="RowList" Focusable="False"
                                          ItemTemplateSelector="{StaticResource RowTemplates}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="ItemsSource" Value="{Binding Rows}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowHomeTiles}" Value="True">
                                                <Setter Property="ItemsSource" Value="{x:Null}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            </ItemsControl>
                            <!-- Home: the same rows as tiles, two per line, wide ones alone (TilePanel). -->
                            <ItemsControl x:Name="HomeTileList" Focusable="False" Margin="6,6,10,10"
                                          ItemTemplateSelector="{StaticResource TileTemplates}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowHomeTiles}" Value="True">
                                                <Setter Property="ItemsSource" Value="{Binding Rows}" />
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:TilePanel Gap="{StaticResource TileGap}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <!--
                              The cover shelf. Its background takes the clicks between covers (they do not close); the
                              top margin leaves room for the lifted first row. The selected tile is drawn above the
                              others (ZIndex), so its lift and glow overlap its neighbours.
                            -->
                            <ItemsControl x:Name="TileList" ItemsSource="{Binding Tiles}" Focusable="False"
                                          ItemTemplate="{StaticResource GameTile}" Background="Transparent"
                                          Margin="{StaticResource ShelfMargin}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Panel.ZIndex" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowTiles}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding TileColumns}"
                                                     VerticalAlignment="Top" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Stage: status corner at the top right, context card at the bottom. Only the cards take the mouse. -->
            <Grid x:Name="Stage" Grid.Column="2" Margin="{Binding StagePadding}">
                <Border x:Name="StatusCorner" Style="{StaticResource GlassCard}" Padding="18,6,18,8"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding SizeFactor}" ScaleY="{Binding SizeFactor}" />
                    </Border.LayoutTransform>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutputDevice}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding OutputGlyph}"
                                       FontSize="{StaticResource StatusSize}" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding OutputDevice}" Margin="8,0,0,0" MaxWidth="240"
                                       FontSize="{StaticResource StatusSize}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding BatteryGlyph}" Value="" />
                                                <Condition Binding="{Binding BatteryText}" Value="" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding BatteryGlyph}"
                                       FontSize="{StaticResource StatusSize}" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding BatteryText}" Margin="6,0,0,0" FontSize="{StaticResource StatusSize}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BatteryText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="{StaticResource ClockSize}" FontWeight="Light" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!--
                  Context of the selected row (ContextVm): the template follows its Kind (monitors, mixer, album art,
                  volume, else the label / value / description card). Hidden on the Games shelf (the column takes the
                  stage) and when there is nothing to say. Cards swap at once (no cross-fade yet).
                -->
                <ContentControl x:Name="ContextHost" Focusable="False" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Content="{Binding Context}"
                                ContentTemplateSelector="{StaticResource ContextTemplates}">
                    <ContentControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding SizeFactor}" ScaleY="{Binding SizeFactor}" />
                    </ContentControl.LayoutTransform>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Context}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWide}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
