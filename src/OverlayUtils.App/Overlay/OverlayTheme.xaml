<!--
  Palette and shared styles of the overlay (Python OV_* colours, sizes at 96 dpi).
  The accent is not here: the window publishes OverlayViewModel.AccentBrush as the
  dynamic resource "Accent", so the Windows accent can replace it at run time.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <SolidColorBrush x:Key="Bg" Color="#202020" />
    <SolidColorBrush x:Key="Surface" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Line" Color="#3E3E3E" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Muted" Color="#A5A5A5" />
    <SolidColorBrush x:Key="Subtle" Color="#737373" />
    <SolidColorBrush x:Key="Danger" Color="#DC4646" />
    <SolidColorBrush x:Key="SegmentBg" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SegmentActive" Color="#444444" />

    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Selection tint: the accent at low opacity over the row (Python OV_SELECTED on a blue accent). -->
    <sys:Double x:Key="TintOpacity">0.16</sys:Double>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Keycap: a key name in a bordered box (Python _keycap). -->
    <Style x:Key="Keycap" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeycapText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Thin separator line between header, list and description. -->
    <Style x:Key="Separator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="14,0" />
        <Setter Property="Fill" Value="{StaticResource Line}" />
    </Style>
</ResourceDictionary>
