<!--
  Palette and shared styles of the overlay (Python OV_* colours, sizes at 96 dpi).
  The accent is not here: the window publishes OverlayViewModel.AccentBrush as the
  dynamic resource "Accent", so the Windows accent can replace it at run time.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <SolidColorBrush x:Key="Bg" Color="#202020" />
    <SolidColorBrush x:Key="Surface" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Line" Color="#3E3E3E" />
    <SolidColorBrush x:Key="Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Muted" Color="#A5A5A5" />
    <SolidColorBrush x:Key="Subtle" Color="#737373" />
    <SolidColorBrush x:Key="Danger" Color="#DC4646" />
    <SolidColorBrush x:Key="SegmentBg" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SegmentActive" Color="#444444" />
    <!-- Mouse over a clickable element (button, arrow, option, rail icon, footer hint). -->
    <SolidColorBrush x:Key="Hover" Color="#26FFFFFF" />

    <!-- Full-screen frame. FrameBg is the window's opaque background and the colour of the backdrop gradient. -->
    <SolidColorBrush x:Key="FrameBg" Color="#080A10" />
    <!-- White frost over the screenshot; its opacity comes from the Appearance settings. -->
    <SolidColorBrush x:Key="FrostTint" Color="#FFFFFF" />
    <!-- Hairline on the right edge of the rail. -->
    <SolidColorBrush x:Key="RailLine" Color="#0FFFFFFF" />
    <!-- Cards inside the column (Info panels, media card, game tiles): light glass over the dark side. -->
    <SolidColorBrush x:Key="CardBg" Color="#11FFFFFF" />
    <SolidColorBrush x:Key="CardLine" Color="#12FFFFFF" />
    <!-- Dark glass under text on the stage (status corner, context card), which can sit over a bright game. -->
    <SolidColorBrush x:Key="GlassBg" Color="#8C0A0C12" />
    <SolidColorBrush x:Key="GlassLine" Color="#14FFFFFF" />
    <!-- Fades the selected row's tint from left to right (opacity mask). -->
    <LinearGradientBrush x:Key="TintFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF000000" Offset="0" />
        <GradientStop Color="#4D000000" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Selection tint: the accent at low opacity over the row (Python OV_SELECTED on a blue accent). -->
    <sys:Double x:Key="TintOpacity">0.20</sys:Double>

    <!-- Type ramp of the frame, in DIPs at size factor 1 (the frame scales them with the size setting). -->
    <sys:Double x:Key="EyebrowSize">12</sys:Double>
    <sys:Double x:Key="PageTitleSize">34</sys:Double>
    <sys:Double x:Key="RailGlyphSize">20</sys:Double>
    <sys:Double x:Key="RailButtonSize">52</sys:Double>
    <sys:Double x:Key="ClockSize">30</sys:Double>
    <sys:Double x:Key="StatusSize">14</sys:Double>
    <sys:Double x:Key="ContextSize">14</sys:Double>
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <sys:Double x:Key="RowLabelSize">15</sys:Double>
    <sys:Double x:Key="RowGlyphSize">17</sys:Double>
    <!-- Room above and below the rail icons: the gear (52) plus its bottom margin (28). -->
    <sys:Double x:Key="RailEndHeight">80</sys:Double>

    <!-- Home tiles (2-column grid in the column; volume and now playing span both). -->
    <sys:Double x:Key="TileHeight">96</sys:Double>
    <sys:Double x:Key="TileGap">12</sys:Double>
    <sys:Double x:Key="TileCaptionSize">11</sys:Double>
    <sys:Double x:Key="TileGlyphSize">15</sys:Double>
    <sys:Double x:Key="TileValueSize">24</sys:Double>
    <sys:Double x:Key="TileTextSize">16</sys:Double>
    <CornerRadius x:Key="TileCorner">14</CornerRadius>
    <!-- Soft accent halo around the selected tile (a blurred ring). -->
    <sys:Double x:Key="TileGlowOpacity">0.55</sys:Double>
    <sys:Double x:Key="TileGlowRadius">12</sys:Double>

    <!-- Stage context cards (bottom left of the stage). -->
    <sys:Double x:Key="ContextWidth">460</sys:Double>
    <sys:Double x:Key="ContextTitleSize">20</sys:Double>
    <sys:Double x:Key="ContextValueSize">15</sys:Double>
    <sys:Double x:Key="ContextBigSize">30</sys:Double>
    <sys:Double x:Key="ContextGlyphSize">18</sys:Double>
    <!-- Now playing: the album art, square. -->
    <sys:Double x:Key="ContextArtSize">260</sys:Double>
    <sys:Double x:Key="ContextArtGlyphSize">64</sys:Double>
    <!-- Monitors: one small screen per profile. -->
    <sys:Double x:Key="MonitorWidth">76</sys:Double>
    <sys:Double x:Key="MonitorHeight">46</sys:Double>
    <Thickness x:Key="MonitorMargin">0,0,22,6</Thickness>
    <!-- Mixer: one vertical bar per channel plus master. -->
    <sys:Double x:Key="MixerBarWidth">16</sys:Double>
    <sys:Double x:Key="MixerBarHeight">150</sys:Double>
    <sys:Double x:Key="MixerSlotWidth">64</sys:Double>
    <SolidColorBrush x:Key="MixerTrack" Color="#26FFFFFF" />

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Keycap: a key name in a bordered box (Python _keycap). -->
    <Style x:Key="Keycap" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="KeycapText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Dark glass card on the stage. -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
</ResourceDictionary>
