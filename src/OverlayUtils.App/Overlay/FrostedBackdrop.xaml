<!--
  Backdrop of the full-screen overlay: the frosted screenshot taken at open, bottom to top image, white frost,
  static grain, dark gradient. Image, frost and grain fade in together once the image is ready; without one only
  the window's plain FrameBg shows under the gradient. Only Surface takes the mouse (a click on it closes the
  overlay); every layer is IsHitTestVisible="False".
-->
<UserControl x:Class="OverlayUtils.App.Overlay.FrostedBackdrop" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid x:Name="Surface" Background="Transparent" ClipToBounds="True">
        <Grid x:Name="Shot" Opacity="0" IsHitTestVisible="False">
            <Image x:Name="Picture" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
            <Rectangle x:Name="FrostLayer" Fill="{DynamicResource FrostTint}" />
            <Rectangle x:Name="Grain" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Grid>
        <Rectangle x:Name="Dim" IsHitTestVisible="False" />
    </Grid>
</UserControl>
