<!--
  Small volume / microphone indicator for the pad shortcuts with the overlay closed (Back + Left / Right, Back + Y).
  Never activated, topmost and click-through; the code-behind places it on the foreground window's monitor and hides
  it after about 1.5 s. Colours and fonts from OverlayTheme.xaml.
-->
<Window x:Class="OverlayUtils.App.Overlay.VolumeIndicator" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" Focusable="False" IsHitTestVisible="False"
        Width="260" Height="56" FontFamily="{DynamicResource TextFont}" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="OverlayTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="#F2202020" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Left" />
            <Grid x:Name="Bar" Grid.Column="1" Height="4" Margin="8,0,12,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FillColumn" Width="0*" />
                    <ColumnDefinition x:Name="RestColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource Line}" />
                <Border x:Name="Fill" CornerRadius="2" />
            </Grid>
            <TextBlock x:Name="Caption" Grid.Column="1" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            <TextBlock x:Name="Percent" Grid.Column="2" FontSize="14" FontWeight="SemiBold" MinWidth="40"
                       TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Border>
</Window>
